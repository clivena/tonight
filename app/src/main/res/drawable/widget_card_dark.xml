<?xml version="1.0" encoding="utf-8"?>
<!--
    卡片底，夜间档。

    只有两个（浅 / 深），不是「五套色板 × 两档」十个。
    因为卡片底的作用是**提供一块能读的底色**，不是体现色板 ——
    五套色板的 light.background 分别是 #FAFAF8 / #F9FBF8 / #FCFAF6 …，
    肉眼看不出差别，做十份只是给以后留十个要同步改的地方。
    色板体现在文字和金额上（accent 每套都不同），那才是真能看出来的差异。

    用 setImageViewResource 换它，不用 setColorFilter 染色 ——
    后者是反射调用，在某些 ROM 上不生效，而失败的样子是一块纯白卡片，
    夜间档会直接变成「白底浅字」。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1C1E22" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
