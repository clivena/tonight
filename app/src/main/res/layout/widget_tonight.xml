<?xml version="1.0" encoding="utf-8"?>
<!--
    4×2 的组件本体：左边今天的事，右边今天的钱。

    两侧用 layout_weight 而不是各自固定宽度 —— 中文备注有长有短，
    固定宽度要么金额那侧被截，要么任务那侧放不下。
    左 1.05 / 右 1 是个很小的偏置：任务比金额多需要一个字的宽度。

    所有颜色都在代码里 set 进来，这里不写死任何一个色值 ——
    写死就会有「夜间模式下某个字看不见」这种只在一种明暗下成立的 bug。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_light"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="11sp"
                android:text="@string/widget_today" />

            <LinearLayout
                android:id="@+id/task_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!--
            分隔线用 ImageView，**不能用 View**。

            RemoteViews 只认带 @RemoteView 注解的类，而 android.view.View
            本身没有这个注解 —— 只有它的子类（TextView / ImageView …）有。
            写 <View> 的后果不是"线画不出来"，而是**整个组件 inflate 失败**，
            桌面上显示「载入窗口小插件时出现问题」，而且 updateAppWidget()
            不会抛任何异常（apply 发生在 launcher 进程），
            从 App 这边完全看不出发生了什么。

            颜色仍然由 setInt(id, "setBackgroundColor", color) 在代码里给，
            View.setBackgroundColor 带 @RemotableViewMethod，所以这条能过。
        -->
        <ImageView
            android:id="@+id/divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/money_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="11sp"
                android:text="@string/widget_spent" />

            <TextView
                android:id="@+id/money_sum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="24sp"
                android:text="@string/widget_zero_money" />

            <LinearLayout
                android:id="@+id/money_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
