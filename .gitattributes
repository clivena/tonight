# 默认：检出时自动选择换行符，提交时统一存为 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则可能执行异常
*.bat text eol=crlf
*.cmd text eol=crlf

# gradlew 是 shell 脚本，必须 LF 且可执行
gradlew text eol=lf

# 源码与配置：统一 LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf

# 二进制：不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.apk binary
*.aab binary
